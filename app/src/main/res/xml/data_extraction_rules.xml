<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to a backup or a new phone: the sign-in token is encrypted with a key that
     never leaves this device, so a copy elsewhere can't be read, and the library and downloads
     come back from the server anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
